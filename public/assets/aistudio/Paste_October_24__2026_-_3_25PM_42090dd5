        // دالة المزامنة الذكية مع ملف مدرستي / نور (Excel / CSV)
        function syncFromMadrasatiExcel() {
            const fileInput = document.getElementById('madrasatiFileInput');
            const file = fileInput.files[0];

            if (!file) {
                alert('⚠️ يرجى اختيار ملف كشف الطلاب أولاً بصيغة (Excel أو CSV).');
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const firstSheetName = workbook.SheetNames[0];
                    const worksheet = workbook.Sheets[firstSheetName];
                    const rows = XLSX.utils.sheet_to_json(worksheet, { defval: '' });

                    if (!rows || rows.length === 0) {
                        alert('❌ الملف المرفوع فارغ ولا يحتوي على بيانات.');
                        return;
                    }

                    const incomingStudents = [];
                    const distinctClasses = new Set();

                    rows.forEach((row, idx) => {
                        const name = row['اسم الطالب'] || row['الاسم'] || row['اسم_الطالب'] || row['الطالب'] || row['Name'] || '';
                        const role = row['الصف'] || row['الصف الدراسي'] || row['الفصل'] || row['المرحلة'] || 'الصف الابتدائي';
                        const info = row['معلومات'] || row['ملاحظات'] || row['الحالة'] || 'مسجل رسمياً عبر منصة مدرستي';

                        if (name.trim()) {
                            incomingStudents.push({
                                id: Date.now() + idx,
                                name: name.trim(),
                                role: role.trim(),
                                info: info.trim()
                            });
                            distinctClasses.add(role.trim());
                        }
                    });

                    if (incomingStudents.length === 0) {
                        alert('❌ لم يتم العثور على عمود يحتوي على (اسم الطالب) داخل الملف.');
                        return;
                    }

                    const oldNames = new Set(appData.students.map(s => s.name));
                    const newNames = new Set(incomingStudents.map(s => s.name));

                    let addedCount = 0;
                    let removedCount = 0;

                    incomingStudents.forEach(s => {
                        if (!oldNames.has(s.name)) addedCount++;
                    });

                    appData.students.forEach(s => {
                        if (!newNames.has(s.name)) removedCount++;
                    });

                    appData.students = incomingStudents;
                    appData.stats.students = incomingStudents.length;
                    if (distinctClasses.size > 0) {
                        appData.stats.classes = distinctClasses.size;
                    }

                    syncStorage();
                    renderStats();
                    renderStudents();
                    loadDashboardInputs();

                    const reportBox = document.getElementById('syncReportBox');
                    const summary = document.getElementById('syncReportSummary');
                    reportBox.style.display = 'block';
                    summary.innerHTML = `
                        <p>✅ <b>تمت المزامنة بنجاح تام وتحديث الموقع!</b></p>
                        <div style="margin-top:0.6rem;">
                            <span class="sync-badge-stat badge-added">➕ إضافة ${addedCount} طالب مستجد</span>
                            <span class="sync-badge-stat badge-removed">➖ استبعاد ${removedCount} طالب غير مدرج</span>
                            <span class="sync-badge-stat badge-total">👥 إجمالي الطلاب: ${incomingStudents.length}</span>
                            <span class="sync-badge-stat badge-total">🏫 الفصول المعتمدة: ${distinctClasses.size}</span>
                        </div>
                    `;

                    alert(`🎉 تم بنجاح مزامنة وتحديث ${incomingStudents.length} طالباً وانعكست فوراً على الموقع!`);
                } catch (err) {
                    console.error(err);
                    alert('❌ حدث خطأ أثناء قراءة الملف. تأكد من أن الملف بصيغة إكسل صحيحة.');
                }
            };
            reader.readAsArrayBuffer(file);
        }

